  "politikamiz": {
    "metaTitle": "我们的政策 | Novves",
    "metaDescription": "NOVVES 综合管理政策 — 环境、可持续发展、职业健康和安全、质量管理。",
    "breadcrumbHome": "家",
    "breadcrumbCorporate": "公司的",
    "breadcrumbPage": "我们的政策",
    "badge": "公司的",
    "heroTitle1": "综合管理",
    "heroTitleHighlight": "政策",
    "introCompany": "NOVVES Elektrik Motor A.Ş.",
    "introTitle": "质量、环境和职业安全",
    "introP1": "作为 NOVVES Elektrik Motor A.Ş.，我们完全遵守国家和国际法规，在亚洛瓦拥有 3,000 平方米的生产设施，总部位于伊斯坦布尔 Kozyatağı。",
    "introP2Before": "在工业和舒适风扇系统的生产中，不断提高质量，提供创新解决方案并保持客户满意度",
    "introP2Bold": "始终处于最高水平",
    "introP2After": "是我们的首要目标。",
    "sections": [
      {
        "title": "环境与可持续发展",
        "number": "01",
        "items": [
          "我们高效且有效地利用自然资源。",
          "我们最大限度地减少废物并在不损害环境的情况下对其进行处理。",
          "我们从源头预防各类污染，开展环保活动。",
          "我们不断改进回收、再利用和其他废物管理实践。",
          "我们的目标是成为能源效率和可持续能源利用的先驱。",
          "我们授权员工在必要时停止可能危害环境的工作。"
        ]
      },
      {
        "title": "职业健康与安全",
        "number": "02",
        "items": [
          "我们评估环境和职业风险，以建立预防工作场所事故的系统。",
          "我们在所有设备中都使用安全、可持续和现代的技术。",
          "我们实施培训和预防措施，预防职业病。",
          "我们采取积极主动的方法来预测风险并采取预防措施。",
          "我们不断审查我们的职业健康和安全绩效并更新我们的目标。"
        ]
      },
      {
        "title": "员工参与与发展",
        "number": "03",
        "items": [
          "我们定期组织培训，以提高所有员工的知识和能力。",
          "我们将员工代表纳入决策过程并鼓励积极参与。",
          "我们通过消除参与障碍来增强组织承诺。"
        ]
      },
      {
        "title": "绩效和利益相关者关注",
