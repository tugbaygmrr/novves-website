# ===========================================
# Environment Variables Template
# Copy this to .env.local and fill in values
# ===========================================

# Site kök URL — SEO canonical / Open Graph / metadataBase (sonunda / olmasın)
# Production deploy'da mutlaka ayarlayın (ikisinden biri yeterli):
# NEXT_PUBLIC_APP_URL=https://www.novves.com
# NEXT_PUBLIC_SITE_URL=https://www.novves.com
# Geliştirme:
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Places API — iletişim lokasyon fotoğrafları (npm run iletisim:google-photos)
# GOOGLE_MAPS_API_KEY=

# Instagram Graph API — sosyal medya sayfasında güncel Instagram postları
# Meta Business Suite → Instagram hesabı → uzun ömürlü erişim jetonu
# INSTAGRAM_ACCESS_TOKEN=
# Business API için Instagram işletme hesabı kimliği (opsiyonel):
# INSTAGRAM_USER_ID=
# INSTAGRAM_POST_LIMIT=6
# Jetonu önbelleğe almak için: npm run instagram:sync

# Uzak Postgres (Neon, Supabase, Vercel Postgres): sorgu dizesinde sslmode=require kullanın veya:
# DATABASE_SSL=true
# Sertifika doğrulaması açık istenirse: DATABASE_SSL_REJECT_UNAUTHORIZED=true
#
# DATABASE_URL=postgresql://user:password@localhost:5432/novves
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#
# Geçici admin oluşturmak: ADMIN_USERNAME ve ADMIN_PASSWORD ayarla, sonra `npm run admin:create`
# (Script .env.local / .env içindeki DATABASE_URL’i de okur.)
# Admin panel girişi (production): en az 32 karakter
# JWT_SECRET=your-random-secret-at-least-32-chars-long
# AUTH_SECRET=
# AUTH_URL=http://localhost:3000
#
# Iletisim formu e-posta (SMTP)
# CONTACT_FORM_TO=info@novves.com
# CONTACT_FORM_FROM="NOVVES Web <info@novves.com>"
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=info@novves.com
# SMTP_PASS=uygulama-sifresi
